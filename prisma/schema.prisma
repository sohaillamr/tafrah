generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserCategory {
  AUTISM
  CP
  LEARNING_HARDENING
  NONE
}

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  phone         String?
  passwordHash  String
  name          String
  role          String   @default("student") // student | hr | admin
  status        String   @default("pending") // pending | verified | banned
  category      UserCategory @default(NONE)
  uiPreferences Json?
  quizScore     Int?
  avatarUrl     String?
  bio           String?
  jobTitle      String?
  available     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  enrollments      Enrollment[]
  progress         Progress[]
  sentMessages     Message[]     @relation("SentMessages")
  receivedMessages Message[]     @relation("ReceivedMessages")
  tickets          Ticket[]
  activityLogs     ActivityLog[]
  preferences      UserPreference?
  skillProfile     SkillProfile?
  serviceCardSimulations ServiceCardSimulation[]
  centerId         Int?
  center           Center?       @relation(fields: [centerId], references: [id])
  chapterId        Int?
  chapter          Chapter?      @relation(fields: [chapterId], references: [id])

  @@index([status])
  @@index([role])
}

model UserPreference {
  id                 Int      @id @default(autoincrement())
  userId             Int      @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  formattingPrefs    String?  // e.g. "prefers code snippets", "no lengthy paragraphs"
  sensoryTriggers    String?  // e.g. "frustrates easily on CSS syntax"
  theme              String   @default("light") // light | dark | sepia | high-contrast
  reduceMotion       Boolean  @default(false)
  mascot             String?  // e.g. "owl", "cat", "none"
  uiSettings         Json?    // Stores font size, contrast, spacing, etc.
  learningStyle      String?  // visual, step-by-step, text-heavy
  nourTone           String   @default("calm") // calm, enthusiastic, direct
  dailyEnergyLog     Json?    // e.g. [{ date: '2023-10-27', level: 'low' }]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model SkillProfile {
  id                   Int      @id @default(autoincrement())
  userId               Int      @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  logicFlow            Int      @default(10)
  attentionToDetail    Int      @default(10)
  syntaxAccuracy       Int      @default(10)
  patternRecognition   Int      @default(10)
  problemDecomposition Int      @default(10)
  badges               Json?    // Array of earned badges
  projects             Json?    // Array of digital lab projects
  verifiedProjects     Json?    // e.g., [{ id: "1", title: "Data Clean", aiVerified: true }]
  strengthsSummary     Json?    // Structured JSON of cognitive advantages
  careerReadiness      Int      @default(0) // 0-100 scale
  updatedAt            DateTime @updatedAt
}

model Course {
  id         Int      @id @default(autoincrement())
  slug       String   @unique
  titleAr    String
  titleEn    String
  descAr     String
  descEn     String
  category   String
  difficulty String // beginner | intermediate | advanced
  hours      Int
  modules    Int
  available  Boolean  @default(false)
  isArchived Boolean  @default(false)
  imageUrl   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  enrollments Enrollment[]

  @@index([available])
  @@index([category])
  @@index([isArchived])
}

model Enrollment {
  id          Int       @id @default(autoincrement())
  userId      Int
  courseId    Int
  progress    Float     @default(0) // 0-100
  completed   Boolean   @default(false)
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model Progress {
  id         Int      @id @default(autoincrement())
  userId     Int
  courseSlug String
  unitIndex  Int
  stepIndex  Int
  quizPassed Boolean  @default(false)
  quizScore  Float?
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseSlug, unitIndex])
  @@index([userId])
  @@index([courseSlug])
}





model Message {
  id         Int      @id @default(autoincrement())
  senderId   Int
  receiverId Int
  content    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
}

model Ticket {
  id        Int      @id @default(autoincrement())
  userId    Int?
  subject   String
  message   String
  email     String
  status    String   @default("new") // new | in-progress | resolved | closed
  priority  String   @default("normal") // low | normal | high
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String // login | signup | enroll | complete_unit | apply_job | send_message | etc
  details   String?
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model SiteSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model RateLimitEntry {
  id      Int      @id @default(autoincrement())
  key     String
  count   Int      @default(1)
  resetAt DateTime

  @@unique([key])
  @@index([resetAt])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String
  details   String?
  admin     String
  ip        String?
  createdAt DateTime @default(now())

  @@index([action])
  @@index([admin])
  @@index([createdAt])
}

model ServiceCardSimulation {
  id                 Int      @id @default(autoincrement())
  userId             Int?
  user               User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  applicantName      String?
  age                Int?
  governorate        String?
  disabilityType     String
  documentReadiness  Int
  supportNeedScore   Int
  cognitiveScore     Int?
  readinessScore     Int
  pathway            String
  answers            Json?
  documents          Json?
  recommendations    Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId])
  @@index([createdAt])
  @@index([disabilityType])
}



model Center {
  id        Int      @id @default(autoincrement())
  name      String
  licenseKey String  @unique
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  students  User[]
  chapters  Chapter[]
}

model Chapter {
  id        Int      @id @default(autoincrement())
  name      String
  centerId  Int
  center    Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  students  User[]
  
  @@index([centerId])
}
